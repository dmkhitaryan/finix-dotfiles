diff --git a/ldso/dynlink.c b/ldso/dynlink.c
--- a/ldso/dynlink.c
+++ b/ldso/dynlink.c
@@ -1365,6 +1365,42 @@ static void load_preload(char *s)
 	}
 }

+#ifndef PRELOAD_FILE
+#define PRELOAD_FILE "/etc/ld-musl-" LDSO_ARCH ".preload"
+#endif
+
+// Does the executable itself ask for a malloc-replacing library?
+static int app_brings_allocator(struct dso *app)
+{
+	size_t i;
+	if (!app->dynv || !app->strings) return 0;
+	for (i=0; app->dynv[i]; i+=2) {
+		if (app->dynv[i] != DT_NEEDED) continue;
+		if (strstr(app->strings + app->dynv[i+1], "malloc")) return 1;
+	}
+	return 0;
+}
+
+// System-wide LD_PRELOAD; skipped for setuid, with LD_NO_PRELOAD_FILE,
+// and for executables that bring their own allocator.
+static void load_preload_file(void)
+{
+	struct stat st;
+	char *buf;
+	ssize_t n;
+	int fd = open(PRELOAD_FILE, O_RDONLY|O_CLOEXEC);
+	if (fd < 0) return;
+	if (fstat(fd, &st) || !st.st_size || !(buf = malloc(st.st_size+1))) {
+		close(fd);
+		return;
+	}
+	n = read_loop(fd, buf, st.st_size);
+	close(fd);
+	if (n <= 0) return;
+	buf[n] = 0;
+	load_preload(buf);
+}
+
 static void add_syms(struct dso *p)
 {
 	if (!p->syms_next && syms_tail != p) {
@@ -1959,6 +1995,7 @@ void __dls3(size_t *sp, size_t *auxv)
 	/* Load preload/needed libraries, add symbols to global namespace. */
 	ldso.deps = (struct dso **)no_deps;
 	if (env_preload) load_preload(env_preload);
+	if (!libc.secure && !getenv("LD_NO_PRELOAD_FILE") && !app_brings_allocator(&app)) load_preload_file();
  	load_deps(&app);
 	for (struct dso *p=head; p; p=p->next)
 		add_syms(p);
