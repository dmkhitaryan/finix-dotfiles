// Mango + Waybar master
// Style based on DreamMaoMao/waybar-config circle-gruvbox.

{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 4,

    "modules-left": [
        "mango/workspaces",
        "mango/layout",
        "mango/window",
    ],

    "modules-center": [ ],

    "modules-right": [
        "network",
        "cpu",
        "memory",
        "temperature",
        "wireplumber",
        "custom/backlight",
        "battery",
        "clock",
    ],

    "mango/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "hide-empty": true,
        "overview-label": "󰍉"
    },

    "mango/layout": {
        "format": "{symbol}"
    },

    "mango/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 18,
        "max-length": 25
    },

    "custom/notch": {
        "format": "",
        "tooltip": false
    },

    "tray": {
        "icon-size": 19,
        "spacing": 8
    },

    "network": {
        "interval": 2,
        "format-wifi": "{essid} 󰤨",
        "format-ethernet": "{ifname} 󰈀",
        "format-linked": "{ifname} 󰈀",
        "format-disconnected": "Disconnected 󰤭",
        "format-alt": "{ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "on-click": "iwmenu -l fuzzel"
    },

    "cpu": {
        "interval": 2,
        "format": "{usage}% ",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "{percentage}% ",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "temperature": {
        "interval": 2,
        "critical-threshold": 90,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "tooltip": true,
        "tooltip-format": "{node_name}",
        "scroll-step": 2,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "format-icons": [
          "",
          "",
          ""
       ]
    },

    "custom/backlight": {
        "exec": "printf '%d%%\\n' \"$(( $(brightnessctl g) * 100 / $(brightnessctl m) ))\"",
        "interval": 2,
        "format": "{} 󰃠",
        "on-scroll-up": "brightnessctl -q set +2%",
        "on-scroll-down": "brightnessctl -q set 2%-"
    },

    "battery": {
        "interval": 5,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip": true
    },

    "clock": {
        "locale": "C",
        "format": "{:%H:%M} ",
        "format-alt": "{:%A, %d %B} 󰃭",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ebdbb2'><b>{}</b></span>",
                "days": "<span color='#d5c4a1'>{}</span>",
                "weeks": "<span color='#83a598'>W{}</span>",
                "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
                "today": "<span color='#fb4934'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout -b 6 --protocol layer-shell"
    }
}
